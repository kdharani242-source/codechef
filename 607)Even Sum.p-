import sys

# Read all inputs from standard input at once
input_data = sys.stdin.read().split()

if input_data:
    T = int(input_data[0])
    idx = 1
    
    for _ in range(T):
        N = int(input_data[idx])
        idx += 1
        
        a = [int(x) for x in input_data[idx:idx+N]]
        idx += N
        
        total_sum = sum(a)
        ans = "No"
        
        for x in a:
            if (total_sum - x) % 2 == 0:
                ans = "Yes"
                break
            else:
                pass
                
        print(ans)
