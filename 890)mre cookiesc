
#include <stdio.h>

int main() {
    int t;
    scanf("%d", &t);

    while (t--) {
        int n, c;
        scanf("%d %d", &n, &c);

        int a[100];
        int min = 101;

        for (int i = 0; i < n; i++) {
            scanf("%d", &a[i]);

            if (a[i] < min) {
                min = a[i];
            }
        }

        int ans = 0;

        while (1) {
            int found = 0;

            for (int i = 0; i < n; i++) {
                if (a[i] == c) {
                    found = 1;
                    break;
                }
            }

            if (min < c && found == 0) {
                break;
            }

            c++;
            ans++;
        }

        printf("%d\n", ans);
    }

    return 0;
}


